<?php

/**
 * Default asynchronous settings for Ajax polling.
 *
 * Copy this file to `config/async.settings.php` and modify values as needed.
 */

return [
    // Verbose async logging in the browser console, prefixed with "[LotGD async]".
    // Set to 1 while debugging polling, mail or timeout behaviour; 0 for production.
    // This only affects logging. It does not change any interval below.
    //
    // Replaces the former `mail_debug`, which despite its name overrode the poll
    // interval with 500 seconds instead of producing more output. The old key is still
    // read for backwards compatibility but no longer changes timing.
    'debug_console' => 0,

    // How async/process.php treats a missing or wrong CSRF token.
    //
    //   'off'     - do not look at it
    //   'log'     - check it, record failures via error_log, let the request through
    //   'enforce' - refuse the request with HTTP 403
    //
    // Still ships as 'log', and the reason is no longer the transport.
    //
    // The transport is now verified: the Jaxon runtime is served from
    // async/js/vendor/jaxon rather than a CDN, and the header was confirmed to
    // reach the server in a real browser against those exact files. That check
    // also found why it could not have worked before -- Jaxon defaults
    // httpRequestOptions.mode to 'no-cors', under which the browser silently
    // drops every non-safelisted header. lotgd.jaxon.js now sets 'same-origin'.
    //
    // What remains is the upgrade itself. The client is inlined into each page,
    // so a page rendered *before* the upgrade is still running the old one: it
    // sets no 'same-origin', so its header is dropped, and it has no recovery
    // handler either. Enforcing at upgrade time would leave those tabs polling
    // into a 403 with nothing to fix it but a manual reload.
    //
    // So: deploy, let the tabs age out, confirm error_log carries no
    // "Jaxon csrf" lines, then set this to 'enforce' at a time of your
    // choosing. Every client rendered after the upgrade can recover on its own.
    //
    // Only logged-in callers are recorded, so that signal stays about players:
    // an unauthenticated request is refused on authentication whatever its
    // token says, and a timed-out tab polling on -- or anyone POSTing to the
    // endpoint -- would otherwise keep the log from ever going quiet.
    'csrf_mode' => 'log',

    // Prevent session timeout while the browser remains open.
    'never_timeout_if_browser_open' => 0,

    // Minimum time in seconds between Ajax requests from the same session.
    'ajax_rate_limit_seconds' => 1.0,

    // How often the client polls for new mail, comments and timeout status, in seconds.
    'check_mail_timeout_seconds' => 10,

    // Reserved; currently not evaluated by the async layer.
    'check_timeout_seconds' => 5,

    // Seconds of remaining session time at which the timeout counter starts to show.
    'start_timeout_show_seconds' => 300,

    // When the client should stop polling entirely. -1 disables the cutoff.
    'clear_script_execution_seconds' => -1,
];
