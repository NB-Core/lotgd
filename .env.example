# TEMPLATE ONLY: copy this file to .env and generate unique secrets before use.
# The copy holds both database passwords in plain text: `chmod 600 .env`.
# Compose reads this file for interpolation; the web container receives only the
# variables listed in its own `environment:` block, never the whole file.
MYSQL_DATABASE=lotgd
MYSQL_HOST=db
MYSQL_USER=lotgduser
# Intentionally blank: generate each value separately with the command below.
# Do not start Compose directly with this template.
#   openssl rand -base64 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# The Docker image and Compose service create and own this persistent path and
# set both values for the containers themselves; the entries here document the
# defaults and are what a non-Compose deployment would need.
MYSQL_USEDATACACHE=1
MYSQL_DATACACHEPATH=/var/cache/lotgd

# The installer is denied unless an administrator deliberately changes this to 1.
LOTGD_INSTALL_ENABLED=0

# Loopback-only host port for initial installation. Terminate TLS in a reverse
# proxy when exposing an installed instance in production.
LOTGD_HTTP_PORT=8080
