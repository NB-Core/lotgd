<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8"/>
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ meta_description }}">
    {{ headscript_pre|raw }}
    <link rel="stylesheet" href="{{ 'bootstrap'|asset('css') }}">
    {{ headscript_mid|raw }}
    <link rel="stylesheet" href="{{ '/templates/common/colors.css'|ver }}"/>
    <link rel="stylesheet" href="{{ ('/' ~ template_path ~ '/assets/style.css')|ver }}"/>
    {{ headscript|raw }}{{ script|raw }}
</head>
<body class="main-body">
{% set right_sidebar %}
    {{ stats|raw }}<br/>
    {{ paypal|raw }}
{% endset %}
<div class="container-fluid">
    <div class="row page-header align-items-center">
        <div class="col-4 pageheader-left text-center">
            <div class="d-flex gap-2 justify-content-center">
                <div class="motd">&nbsp;&nbsp;<strong>{{ motd|raw }}</strong></div>
                <div class="petition"><strong>{{ petition|raw }}</strong></div>
            </div>
        </div>
        <div class="col-4 pageheader-center text-center">
            {{ title }}
        </div>
        <div class="col-4 pageheader-right text-end">
            <nav class="mail-nav justify-content-end" aria-label="Player notifications">
                <span class="mail-nav__link">
                    <img src="{{ '/' ~ template_path }}/assets/mail.gif" width="24" height="19" alt="Mail">
                    <strong>{{ mail|raw }}</strong>
                </span>
                <span class="mail-nav__link">
                    {{ petitiondisplay|raw }}
                </span>
            </nav>
        </div>
    </div>
    <div class="row d-lg-none mobile-toggles">
        <nav class="navbar navbar-dark bg-dark">
            <div class="container-fluid justify-content-end">
                <button class="navbar-toggler me-2" type="button" aria-label="Navigation" data-bs-toggle="offcanvas" data-bs-target="#leftSidebar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <button class="navbar-toggler" type="button" aria-label="Char Stats" data-bs-toggle="offcanvas" data-bs-target="#rightSidebar">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>
    </div>
    <div class="row">
        <nav class="col-lg-auto flex-shrink-0 d-none d-lg-block sidebar-content">
            <div class="navad-wrapper">{{ navad|raw }}</div>
            <div class="nav-container" role="navigation">{{ nav|raw }}</div>
        </nav>
        <main class="col flex-grow-1 main-content">
            <div class="verticalad-wrapper">{{ verticalad|raw }}</div>
            {{ bodyad|raw }}
            {{ content|raw }}
        </main>
        <aside class="col-lg-auto flex-shrink-0 d-none d-lg-block sidebar-content">
            {{ right_sidebar|raw }}
        </aside>
    </div>
    <div class="bootstrap-footer row">
        <div class="col-12 col-sm-6">
            {{ copyright|raw }}Design: Puritanic AI Mobile theme by NB-Core
        </div>
        <div class="col-12 col-sm-6 text-end">
            {{ source|raw }}<br />{{ version }}<br />({{ pagegen|raw }})
        </div>
    </div>
</div>
<div class="offcanvas offcanvas-start" tabindex="-1" id="leftSidebar">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        {{ navad|raw }}
        {{ nav|raw }}
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="rightSidebar">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Info</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        {{ right_sidebar|raw }}
    </div>
</div>
<script src="{{ 'bootstrap'|asset('js') }}" defer></script>
</body>
</html>
