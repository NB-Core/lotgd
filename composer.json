{
    "require": {
        "php": ">=8.3",
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.6",
        "jaxon-php/jaxon-core": "^5.5",
        "lbuchs/webauthn": "^2.0",
        "phpmailer/phpmailer": "^7.0",
        "symfony/cache": "^7.2",
        "twig/twig": "^3.23",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Lotgd\\": "src/Lotgd/",
            "Lotgd\\Installer\\": "install/lib/"
        }
    },
    "scripts": {
        "tools:install": "@composer install --working-dir=tools --no-interaction",
        "qa:http-wrappers": "php scripts/check-legacy-http-wrappers.php",
        "qa:sql-addslashes": "php scripts/check-sql-addslashes.php",
        "qa:sql-interpolation": "php scripts/check-sql-value-interpolation.php",
        "qa:vendor-production": "php scripts/check-vendor-production.php",
        "static": [
            "@qa:http-wrappers",
            "@qa:sql-addslashes",
            "@qa:vendor-production",
            "@php tools/vendor/bin/phpstan analyse --configuration phpstan.neon --memory-limit=512M"
        ],
        "test": "@php tools/vendor/bin/phpunit --configuration phpunit.xml",
        "lint": "@php tools/vendor/bin/phpcs .",
        "lint:fix": "@php tools/vendor/bin/phpcbf ."
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "config/composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
